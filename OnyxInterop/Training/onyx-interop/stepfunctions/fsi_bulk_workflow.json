{
  "Comment": "Onyx Interop FSI Bulk Load Workflow (Step 8B)",
  "StartAt": "CheckMongoHealth",
  "States": {
    "CheckMongoHealth": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:ACCOUNT:function:onyx-mongodb-health-check",
      "Next": "ExtractFull"
    },
    "ExtractFull": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:ACCOUNT:function:onyx-extract-full",
      "Next": "ConvertToNDJSON"
    },
    "ConvertToNDJSON": {
      "Type": "Task",
      "Resource": "arn:aws:states:::eks:runJob.sync",
      "Parameters": {
        "ClusterName": "onyx-interop-dev",
        "Job": {
          "apiVersion": "batch/v1",
          "kind": "Job",
          "metadata": {"name": "fsi-converter"},
          "spec": {
            "template": {
              "spec": {
                "containers": [{
                  "name": "fsi-converter",
                  "image": "onyx/firely-fsi-image:latest",
                  "args": ["--input", "s3://bucket/extracts/", "--output", "s3://bucket/exports/bulk/"]
                }],
                "restartPolicy": "Never"
              }
            }
          }
        }
      },
      "Next": "FirelyBulkImport"
    },
    "FirelyBulkImport": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:ACCOUNT:function:onyx-firely-bulk-import",
      "Next": "ValidateCounts"
    },
    "ValidateCounts": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:ACCOUNT:function:onyx-validate-load-counts",
      "End": true
    }
  }
}
