# Phase 0 access configuration — copy to access.env and fill in values.
# NEVER commit access.env (listed in .gitignore).

# --- AWS (dev/stage account) ---
export AWS_PROFILE="${AWS_PROFILE:-onyx-dev}"
export AWS_REGION="${AWS_REGION:-us-east-1}"
# export AWS_ACCESS_KEY_ID=
# export AWS_SECRET_ACCESS_KEY=
# export AWS_SESSION_TOKEN=

# --- GitLab ---
export GITLAB_BASE="${GITLAB_BASE:-https://gitlab.example.com/onyx}"
export GITLAB_TOKEN=
# export GITLAB_USER=

# --- Databricks (PHI VPC workspace via bridge) ---
export DATABRICKS_HOST="${DATABRICKS_HOST:-https://dbc-example.cloud.databricks.com}"
export DATABRICKS_TOKEN=
export DATABRICKS_CONFIG_PROFILE="${DATABRICKS_CONFIG_PROFILE:-onyx-dev}"

# --- Seiji deploy tool ---
export SEIJI_HOME="${SEIJI_HOME:-$HOME/.seiji}"
export SEIJI_ENV="${SEIJI_ENV:-dev}"

# --- Helm repo-shims (Kitchen Sous Chef pattern) ---
export HELM_CHARTS_BUCKET="${HELM_CHARTS_BUCKET:-s3://onyx-helm-charts/stable/}"
export REPO_SHIMS_DIR="${REPO_SHIMS_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../repo-shims" && pwd)}"
